{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/about",
      "destination": "/pages/about"
    },
    {
      "source": "/features",
      "destination": "/pages/features"
    },
    {
      "source": "/download",
      "destination": "/pages/download"
    },
    {
      "source": "/opensource",
      "destination": "/pages/opensource"
    },
    {
      "source": "/privacy",
      "destination": "/pages/privacy"
    },
    {
      "source": "/manifesto",
      "destination": "/pages/manifesto"
    },
    {
      "source": "/documentation",
      "destination": "/pages/documentation"
    }
  ]
}
