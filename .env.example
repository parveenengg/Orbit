# Orbit Website Environment Configuration Template
# Orbit is a static client-side web application.
# IMPORTANT: DO NOT add backend secrets, database passwords, or private API keys to this repository.
# All code in this repository is delivered publicly to the client.

# Optional: Public site domain configuration
SITE_URL=https://orbitbrowser.com

# Optional: Vercel Analytics tracking toggle (1 = enabled, 0 = disabled)
NEXT_PUBLIC_ANALYTICS_ENABLED=0
