# Orbit Website — Environment & Supabase Configuration Guide
#
# This is a static HTML/CSS/JS website.
# Runtime Supabase client credentials are configured in js/orbit-supabase.js.
#
# IMPORTANT SECURITY RULES:
#   - NEVER place the Supabase SERVICE_ROLE key in browser JavaScript or .env files in Git.
#   - ONLY the ANON / public key is placed in js/orbit-supabase.js.
#   - RLS (Row Level Security) MUST be enabled to prevent anonymous users from reading,
#     modifying, or deleting support submissions or attachments.
#
# ── Supabase Configuration ───────────────────────────────────────────────────
# Obtain credentials from: Supabase Dashboard -> Project Settings -> API
#
# Paste public values into js/orbit-supabase.js:
#   const ORBIT_SUPABASE_URL      = 'https://your-project-ref.supabase.co';
#   const ORBIT_SUPABASE_ANON_KEY = 'eyJ...';
#
# ── 1. Database Table Creation & Row Level Security (SQL) ─────────────────────
# Run the following SQL in your Supabase SQL Editor:
#
# CREATE TABLE public.support_submissions (
#   id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
#   submitted_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
#   report_type TEXT NOT NULL,
#   description TEXT NOT NULL,
#   name TEXT,
#   email TEXT,
#   platform TEXT,
#   app_version TEXT,
#   steps TEXT,
#   attachment_path TEXT,
#   status TEXT DEFAULT 'open' NOT NULL
# );
#
# -- Enable Row Level Security
# ALTER TABLE public.support_submissions ENABLE ROW LEVEL SECURITY;
#
# -- Allow ANONYMOUS users to INSERT submissions (Write-Only)
# -- Anonymous users CANNOT SELECT, UPDATE, or DELETE any records.
# CREATE POLICY "Allow anonymous support submission insert"
#   ON public.support_submissions
#   FOR INSERT
#   TO anon, authenticated
#   WITH CHECK (true);
#
# ── 2. Storage Bucket Creation (Private Bucket) ───────────────────────────────
# Create a storage bucket in Supabase Dashboard -> Storage:
#   - Bucket name: support-attachments
#   - Public access: DISABLED (public = false / Private bucket)
#
# Add Storage RLS Policy in Supabase Storage Policies:
#
# -- Allow ANONYMOUS users to upload image attachments (INSERT only)
# CREATE POLICY "Allow anonymous attachment uploads"
#   ON storage.objects
#   FOR INSERT
#   TO anon, authenticated
#   WITH CHECK (
#     bucket_id = 'support-attachments' AND
#     (storage.foldername(name))[1] IS NOT NULL
#   );
#
# Note: Because public read is DISABLED and no SELECT policy exists for `anon`,
# public users cannot list, view, or download screenshots uploaded by others.
# The project maintainer can view attachments securely via the Supabase Dashboard
# or generate short-lived signed URLs using the service role / authenticated admin client.
